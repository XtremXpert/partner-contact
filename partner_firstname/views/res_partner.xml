<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form (firstname and lastname)</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//h1/field[@name='name' and @widget='text']"
                position="attributes"
            >
                <attribute name="invisible">not is_company</attribute>
                <attribute name="required">is_company and type == 'contact'</attribute>
            </xpath>
            <xpath
                expr="//h1[field[@name='name' and @widget='text']]"
                position="after"
            >
                <div class="d-flex gap-2" invisible="is_company">
                    <field
                        name="lastname"
                        placeholder="Last name"
                        required="lastname_required"
                    />
                    <field
                        name="firstname"
                        placeholder="First name"
                        required="firstname_required"
                    />
                </div>
                <field name="is_company" invisible="1" />
                <field name="form_has_lastname_first" invisible="1" />
                <field name="firstname_required" invisible="1" />
                <field name="lastname_required" invisible="1" />
            </xpath>
            <!-- Inner form of the child contacts -->
            <xpath
                expr="//field[@name='child_ids']/form//field[@name='name']"
                position="attributes"
            >
                <attribute name="invisible">not is_company</attribute>
                <attribute name="required">is_company and type == 'contact'</attribute>
            </xpath>
            <xpath
                expr="//field[@name='child_ids']/form//h3[field[@name='name']]"
                position="after"
            >
                <div class="d-flex gap-2" invisible="is_company">
                    <field
                        name="lastname"
                        placeholder="Last name"
                        required="lastname_required"
                    />
                    <field
                        name="firstname"
                        placeholder="First name"
                        required="firstname_required"
                    />
                </div>
                <field name="is_company" invisible="1" />
                <field name="form_has_lastname_first" invisible="1" />
                <field name="firstname_required" invisible="1" />
                <field name="lastname_required" invisible="1" />
            </xpath>
        </field>
    </record>
    <record id="view_partner_simple_form" model="ir.ui.view">
        <field name="name">res.partner.simple.form (firstname and lastname)</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple_form" />
        <field name="arch" type="xml">
            <xpath expr="//h1/field[@id='contact']" position="attributes">
                <attribute name="invisible">not is_company</attribute>
                <attribute name="required">is_company and type == 'contact'</attribute>
            </xpath>
            <xpath expr="//h1[field[@id='contact']]" position="after">
                <div class="d-flex gap-2" invisible="is_company">
                    <field
                        name="lastname"
                        placeholder="Last name"
                        required="lastname_required"
                    />
                    <field
                        name="firstname"
                        placeholder="First name"
                        required="firstname_required"
                    />
                </div>
                <field name="is_company" invisible="1" />
                <field name="form_has_lastname_first" invisible="1" />
                <field name="firstname_required" invisible="1" />
                <field name="lastname_required" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
